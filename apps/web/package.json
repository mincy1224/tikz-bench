{
  "name": "@tikz-editor/web",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "build:package-deps": "npm run -w @tikz-editor/lezer-tikz build && npm run -w @tikz-editor/lang-tikz build",
    "generate:example-previews": "npm run build:package-deps && node --import tsx scripts/generate-open-example-previews.ts",
    "debug:multiline": "npm run build:package-deps && node --import tsx scripts/capture-multiline-debug.ts",
    "dev": "npm run generate:example-previews && node ../../scripts/prepare-tikzjax-assets.mjs && vite",
    "build": "npm run generate:example-previews && node ../../scripts/prepare-tikzjax-assets.mjs && vite build",
    "test:e2e": "npm run build:package-deps && node ../../scripts/run-web-e2e.mjs chromium",
    "test:e2e:firefox": "npm run build:package-deps && node ../../scripts/run-web-e2e.mjs firefox",
    "test:e2e:webkit": "npm run build:package-deps && node ../../scripts/run-web-e2e.mjs webkit",
    "test:e2e:all-browsers": "npm run build:package-deps && node ../../scripts/run-web-e2e.mjs chromium,firefox,webkit",
    "test:e2e:headed": "npm run build:package-deps && playwright test --headed",
    "test:e2e:ci": "npm run build:package-deps && node ../../scripts/run-web-e2e.mjs chromium --reporter=line",
    "profile": "node --import tsx scripts/run-profiling.ts --all",
    "profile:landing": "env -u NO_COLOR FORCE_COLOR=0 playwright test --config profiling/playwright.landing.config.ts profiling/profile-landing.spec.ts",
    "profile:analyze": "node ../../scripts/analyze-cpuprofile.mjs",
    "profile:compare": "node ../../scripts/analyze-cpuprofile.mjs compare",
    "profile:compare-report": "node ../../scripts/analyze-cpuprofile.mjs compare-report"
  },
  "dependencies": {
    "@tikz-editor/app": "0.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
